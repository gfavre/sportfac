#: backend/templates/backend/teacher/import.html:15
#: backend/templates/backend/user/child-import.html:14
msgid "About LAGAPEO file format"
msgstr "À propos du format de fichier LAGAPEO"

#: backend/templates/backend/teacher/import.html:17
msgid ""
"\n"
"  <p>We accept files extracted from LAGAPEO. They should be in .xlsx format "
"and have the mandatory\n"
"    columns named like this:</p>\n"
"  <ul>\n"
"    <li>\"Nom\": last name of the teacher</li>\n"
"    <li>\"Prénom\": first name of the teacher</li>\n"
"    <li>\"Maîtrises\" or \"Années\": classes the teacher is responsible for "
"(e.g. \"7S1,7S2\"). Teachers\n"
"      without any class in this column are skipped.</li>\n"
"  </ul>\n"
"  <p>Additional non-mandatory columns can be imported:</p>\n"
"  <ul>\n"
"    <li>\"Numéro SPEV\" or \"ID LAGAPEO\": unique ID of the teacher, used to "
"update an existing teacher\n"
"      on a new import. Without it, matching is done on first and last name.</"
"li>\n"
"    <li>\"Courriel 1\": email address of the teacher</li>\n"
"  </ul>\n"
msgstr ""
"\n"
"  <p>Nous acceptons les fichiers extraits de LAGAPEO. Ils doivent être au "
"format .xlsx et comporter les\n"
"    colonnes obligatoires nommées comme suit :</p>\n"
"  <ul>\n"
"    <li>\"Nom\" : nom de famille de l'enseignant</li>\n"
"    <li>\"Prénom\" : prénom de l'enseignant</li>\n"
"    <li>\"Maîtrises\" ou \"Années\" : classes dont l'enseignant a la charge "
"(p. ex. \"7S1,7S2\"). Les enseignants\n"
"      sans classe dans cette colonne sont ignorés.</li>\n"
"  </ul>\n"
"  <p>Des colonnes supplémentaires, facultatives, peuvent être importées :</"
"p>\n"
"  <ul>\n"
"    <li>\"Numéro SPEV\" ou \"ID LAGAPEO\" : identifiant unique de "
"l'enseignant, utilisé pour mettre à jour un enseignant existant\n"
"      lors d'un nouvel import. Sans cela, la correspondance se fait sur le "
"nom et le prénom.</li>\n"
"    <li>\"Courriel 1\" : adresse e-mail de l'enseignant</li>\n"
"  </ul>\n"

