#: backend/templates/backend/user/child-import.html:16
msgid ""
"\n"
"  <p>We accept files extracted from LAGAPEO. They should be in .xlsx format "
"and have the mandatory\n"
"    columns named like this:</p>\n"
"  <ul>\n"
"    <li>\"ID LAGAPEO\" or \"ELEVE_ID_PERS\" or \"NO\": unique ID of the "
"child</li>\n"
"    <li>\"Nom\" or \"ELEVE_NOM\" or \"NOM\": last name of the child</li>\n"
"    <li>\"Prénom\" or \"ELEVE_PRENOM\" or \"PRENOM\": first name of the "
"child</li>\n"
"    <li>\"Genre\" or \"ELEVE_GENRE\" or \"SEXE\": Gender of the child "
"(values must be f/h or F/G)</li>\n"
"    <li>\"Date de naissance\" or \"ELEVE_DATE_NAISS\" or \"DAT_NAISSANCE\": "
"date of birth of the child</li>\n"
"  </ul>\n"
"  <p>Additional non-mandatory columns can be imported:</p>\n"
"  <ul>\n"
"    <li>\"AVS\" or \"N_AVS\": AVS number</li>\n"
"    <li>\"Année\" or \"ANNEE\" or \"ELEVE_ANNEE_SCOL\" or \"Année2\": School "
"year</li>\n"
"    <li>\"Nationalité\": Nationality</li>\n"
"    <li>\"Langue maternelle\" or \"LANGUE MATERNELLE\": mother tongue</li>\n"
"    <li>\"Etablissement\" or \"ETABLISSEMENT\" or \"ETABLISSEMENT_NOM\": "
"School name</li>\n"
"    <li>\"Blacklist\" or \"BLACKLIST\": Should the child be blacklisted from "
"registrations</li>\n"
"  </ul>\n"
msgstr ""
"\n"
"  <p>Nous acceptons les fichiers extraits de LAGAPEO. Ils doivent être au "
"format .xlsx et comporter les colonnes obligatoires suivantes\n"
"    obligatoires nommées comme suit :</p>\n"
"  <ul>\n"
"    <li>\"ID LAGAPEO\" ou \"ELEVE_ID_PERS\" ou \"NO\" : ID unique de "
"l'enfant</li>\n"
"    <li>\"Nom\" ou \"ELEVE_NOM\" ou \"NOM\" : nom de famille de l'enfant</"
"li>\n"
"    <li>\"Prénom\" ou \"ELEVE_PRENOM\" ou \"PRENOM\" : prénom de l'enfant</"
"li>\n"
"    <li>\"Genre\" ou \"ELEVE_GENRE\" ou \"SEXE\" : Sexe de l'enfant (les "
"valeurs doivent être f/h ou F/G)</li>\n"
"    <li>\"Date de naissance\" ou \"ELEVE_DATE_NAISS\" ou \"DAT_NAISSANCE\" : "
"date de naissance de l'enfant</li>\n"
"  </ul>\n"
"  <p>Des colonnes supplémentaires non obligatoires peuvent être importées :</"
"p>\n"
"  <ul>\n"
"    <li>\"AVS\" ou \"N_AVS\" : Numéro AVS</li>\n"
"    <li>\"Année\" ou \"ANNEE\" ou \"ELEVE_ANNEE_SCOL\" ou \"Année2\" : Année "
"scolaire</li>\n"
"    <li>\"Nationalité\" : Nationalité</li>\n"
"    <li>\"Langue maternelle\" ou \"LANGUE MATERNELLE\" : langue maternelle</"
"li>\n"
"    <li>\"Etablissement\" ou \"ETABLISSEMENT\" ou \"ETABLISSEMENT_NOM\" : "
"Nom de l'établissement</li>\n"
"    <li>\"Blacklist\" ou \"BLACKLIST\" : L'enfant doit-il être inscrit sur "
"une liste noire ?</li>\n"
"  </ul>\n"

